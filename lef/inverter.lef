        RECT 3.750 0.270 4.160 0.775 ;
        RECT 3.990 -0.265 4.160 0.270 ;
        RECT 5.440 -1.170 6.370 1.670 ;
        RECT 2.500 -1.330 6.370 -1.170 ;
        RECT 3.320 -1.340 5.620 -1.330 ;
      LAYER met1 ;
