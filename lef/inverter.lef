MACRO inverter
  CLASS BLOCK ;
  FOREIGN inverter ;
  ORIGIN -1.510 8.140 ;
  SIZE 6.030 BY 12.000 ;
  PIN VDD
    USE POWER ;
    ANTENNADIFFAREA 3.277000 ;
    PORT
      LAYER nwell ;
        RECT 2.930 -1.730 6.010 2.240 ;
      LAYER li1 ;
        RECT 2.500 1.670 6.370 3.860 ;
        RECT 2.500 -1.170 3.500 1.670 ;
