        RECT 3.750 -5.080 4.190 -4.500 ;
        RECT 3.750 -5.750 4.050 -5.080 ;
        RECT 2.480 -5.830 6.370 -5.750 ;
        RECT 2.460 -7.300 6.370 -5.830 ;
        RECT 2.480 -7.940 6.370 -7.300 ;
    END
  END VSS
END inverter
END LIBRARY

